{{- $GiB := 1073741824.0 -}}
{{- $used := printf "%.2f" (divf (add (.UserInfo.Download | default 0 | float64) (.UserInfo.Upload | default 0 | float64)) $GiB) -}}
{{- $traffic := (.UserInfo.Traffic | default 0 | float64) -}}
{{- $total := printf "%.2f" (divf $traffic $GiB) -}}

{{- $ExpiredAt := "" -}}
{{- $expStr := printf "%v" .UserInfo.ExpiredAt -}}
{{- if regexMatch `^[0-9]+$` $expStr -}}
  {{- $ts := $expStr | float64 -}}
  {{- $sec := ternary (divf $ts 1000.0) $ts (ge (len $expStr) 13) -}}
  {{- $ExpiredAt = (date "2006-01-02 15:04:05" (unixEpoch ($sec | int64))) -}}
{{- else -}}
  {{- $ExpiredAt = $expStr -}}
{{- end -}}

{{- $sortFields := list "Sort" "Port" "Name" -}}
{{- $sortConfig := dict "Sort" "asc" "Port" "asc" "Name" "asc" -}}
{{- $byKey := dict -}}
{{- range $p := .Proxies -}}
  {{- $keyParts := list -}}
  {{- range $field := $sortFields -}}
    {{- $order := index $sortConfig $field -}}
    {{- $val := default "" (printf "%v" (index $p $field)) -}}
    {{- if or (eq $field "Sort") (eq $field "Port") -}}
      {{- $val = printf "%08d" (int (default 0 (index $p $field))) -}}
    {{- end -}}
    {{- if eq $order "desc" -}}
      {{- $val = printf "~%s" $val -}}
    {{- end -}}
    {{- $keyParts = append $keyParts $val -}}
  {{- end -}}
  {{- $_ := set $byKey (join "|" $keyParts) $p -}}
{{- end -}}
{{- $sorted := list -}}
{{- range $k := sortAlpha (keys $byKey) -}}
  {{- $sorted = append $sorted (index $byKey $k) -}}
{{- end -}}

{{- $supportSet := dict "shadowsocks" true "vmess" true "vless" true "trojan" true "hysteria2" true "hysteria" true "tuic" true "wireguard" true "anytls" true -}}
{{- $supportedProxies := list -}}
{{- range $proxy := $sorted -}}
  {{- if hasKey $supportSet $proxy.Type -}}
    {{- $supportedProxies = append $supportedProxies $proxy -}}
  {{- else if and (eq $proxy.Type "snell") (eq (int (default 0 $proxy.Version)) 5) -}}
    {{- $supportedProxies = append $supportedProxies $proxy -}}
  {{- end -}}
{{- end -}}

{{- $proxyNames := "" -}}
{{- range $proxy := $supportedProxies -}}
  {{- if eq $proxyNames "" -}}
    {{- $proxyNames = printf "%q" $proxy.Name -}}
  {{- else -}}
    {{- $proxyNames = printf "%s, %q" $proxyNames $proxy.Name -}}
  {{- end -}}
{{- end -}}

# {{ .SiteName }}-{{ .SubscribeName }}
# Traffic: {{ $used }} GiB/{{ $total }} GiB | Expires: {{ $ExpiredAt }}
# Generated at: {{ now | date "2006-01-02 15:04:05" }}

mixed-port: 7890
redir-port: 7891
tproxy-port: 1536
ipv6: true
mode: rule
allow-lan: true
bind-address: '*'
geodata-mode: false
geo-auto-update: true
geo-update-interval: 24
geox-url:
  asn: 'https://github.com/MetaCubeX/meta-rules-dat/releases/download/latest/GeoLite2-ASN.mmdb'
unified-delay: true
tcp-concurrent: true
log-level: info
find-process-mode: always
external-controller: '127.0.0.1:9090'
external-ui-url: 'https://github.com/Zephyruso/zashboard/releases/latest/download/dist.zip'
external-ui: './webroot/Zash/'
secret: ''

profile:
  store-selected: true
  store-fake-ip: true

sniffer:
  enable: true
  force-dns-mapping: true
  parse-pure-ip: true
  override-destination: true
  sniff:
    HTTP:
      ports: [80, 8080-8880]
    TLS:
      ports: [443, 5228, 8443]
    QUIC:
      ports: [443, 8443]
  force-domain:
    - '+.v2ex.com'
  skip-domain:
    - '+.io.mi.com'

tun:
  enable: false
  device: Meta
  stack: gvisor
  dns-hijack:
    - any:53
    - tcp://any:53
  udp-timeout: 300
  auto-route: true
  auto-redirect: false
  auto-detect-interface: true

hosts:
  services.googleapis.cn: services.googleapis.com

dns:
  enable: true
  cache-algorithm: arc
  ipv6: true
  listen: '0.0.0.0:1053'
  use-hosts: true
  use-system-hosts: true
  respect-rules: false
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.0/16
  fake-ip-range6: fdfe:dcba:9876::/64
  fake-ip-filter-mode: rule
  fake-ip-filter:
    - RULE-SET,CN_域,real-ip
    - RULE-SET,Private_域,real-ip
    - RULE-SET,GoogleFCM_域,real-ip
    - MATCH,fake-ip
  default-nameserver:
    - 223.5.5.5
    - 119.29.29.29
  proxy-server-nameserver:
    - 'https://1.12.12.12:443/dns-query#🌐 本机·本地直连&h3=false'
    - 'https://120.53.53.53:443/dns-query#🌐 本机·本地直连&h3=false'
    - 'https://223.5.5.5:443/dns-query#🌐 本机·本地直连&h3=true'
    - 'https://223.6.6.6:443/dns-query#🌐 本机·本地直连&h3=true'
  nameserver-policy:
    'rule-set:CN_域,Microsoft_域,Apple_域':
      - 'https://1.12.12.12:443/dns-query#🌐 本机·本地直连&h3=false'
      - 'https://120.53.53.53:443/dns-query#🌐 本机·本地直连&h3=false'
      - 'https://223.5.5.5:443/dns-query#🌐 本机·本地直连&h3=true'
      - 'https://223.6.6.6:443/dns-query#🌐 本机·本地直连&h3=true'
  nameserver:
    - 'https://8.8.8.8:443/dns-query#DNS连接&h3=true'
    - 'https://8.8.4.4:443/dns-query#DNS连接&h3=true'
    - 'https://1.1.1.1:443/dns-query#DNS连接&h3=false'
    - 'https://1.0.0.1:443/dns-query#DNS连接&h3=false'
  direct-nameserver:
    - system
    - https://dns.alidns.com/dns-query
    - https://doh.pub/dns-query
  direct-nameserver-follow-policy: false

proxies:
{{- range $proxy := $supportedProxies }}
  {{- $server := $proxy.Server -}}
  {{- if and (contains $server ":") (not (hasPrefix "[" $server)) -}}
    {{- $server = printf "[%s]" $server -}}
  {{- end -}}

  {{- $password := $.UserInfo.Password -}}
  {{- if and (eq $proxy.Type "shadowsocks") (ne (default "" $proxy.ServerKey) "") -}}
    {{- $method := $proxy.Method -}}
    {{- if or (hasPrefix "2022-blake3-" $method) (eq $method "2022-blake3-aes-128-gcm") (eq $method "2022-blake3-aes-256-gcm") -}}
      {{- $userKeyLen := ternary 16 32 (hasSuffix "128-gcm" $method) -}}
      {{- $pwdStr := printf "%s" $password -}}
      {{- $userKey := ternary $pwdStr (trunc $userKeyLen $pwdStr) (le (len $pwdStr) $userKeyLen) -}}
      {{- $serverB64 := b64enc $proxy.ServerKey -}}
      {{- $userB64 := b64enc $userKey -}}
      {{- $password = printf "%s:%s" $serverB64 $userB64 -}}
    {{- end -}}
  {{- end -}}

  {{- $SkipVerify := $proxy.AllowInsecure -}}

{{- if eq $proxy.Type "shadowsocks" }}
- name: {{ $proxy.Name | quote }}
  type: ss
  server: {{ $server }}
  port: {{ $proxy.Port }}
  cipher: {{ default "aes-128-gcm" $proxy.Method }}
  password: {{ $password }}
  udp: true
  tfo: true
  {{- $obfsMode := default "" $proxy.Obfs -}}
  {{- if and (ne $obfsMode "") (ne $obfsMode "none") }}
  plugin: obfs
  plugin-opts:
    mode: {{ $obfsMode }}
    {{- if ne (default "" $proxy.ObfsHost) "" }}
    host: {{ $proxy.ObfsHost }}
    {{- end }}
  {{- end }}
{{- else if eq $proxy.Type "vmess" }}
- name: {{ $proxy.Name | quote }}
  type: vmess
  server: {{ $server }}
  port: {{ $proxy.Port }}
  uuid: {{ $password }}
  alterId: 0
  cipher: auto
  udp: true
  tfo: true
  {{- if or (eq $proxy.Transport "websocket") (eq $proxy.Transport "ws") }}
  network: ws
  ws-opts:
    path: {{ default "/" $proxy.Path }}
    {{- if ne (default "" $proxy.Host) "" }}
    headers:
      Host: {{ $proxy.Host }}
    {{- end }}
  {{- else if eq $proxy.Transport "http" }}
  network: http
  http-opts:
    method: GET
    path: [{{ default "/" $proxy.Path | quote }}]
    {{- if ne (default "" $proxy.Host) "" }}
    headers:
      Host: [{{ $proxy.Host | quote }}]
    {{- end }}
  {{- else if eq $proxy.Transport "grpc" }}
  network: grpc
  grpc-opts:
    grpc-service-name: {{ default "grpc" $proxy.ServiceName }}
  {{- end }}
  {{- if or (eq $proxy.Security "tls") (eq $proxy.Security "reality") }}
  tls: true
  {{- end }}
  {{- if ne (default "" $proxy.SNI) "" }}
  servername: {{ $proxy.SNI }}
  {{- end }}
  {{- if $SkipVerify }}
  skip-cert-verify: true
  {{- end }}
  {{- if ne (default "" $proxy.CertPinSHA256) "" }}
  fingerprint: {{ $proxy.CertPinSHA256 }}
  {{- end }}
  {{- if ne (default "" $proxy.Fingerprint) "" }}
  client-fingerprint: {{ $proxy.Fingerprint }}
  {{- end }}
  {{- if $proxy.EchEnable }}
  ech-opts:
    enable: true
    {{- if ne (default "" $proxy.EchServerName) "" }}
    query-server-name: {{ $proxy.EchServerName }}
    {{- end }}
  {{- end }}
{{- else if eq $proxy.Type "vless" }}
  {{- $encryptionStr := "" -}}
  {{- $encryption := default "none" $proxy.Encryption -}}
  {{- if eq $encryption "none" -}}
    {{- $encryptionStr = "none" -}}
  {{- else -}}
    {{- $encParts := list -}}
    {{- $encParts = append $encParts $encryption -}}
    {{- if ne (default "" $proxy.Encryption_Mode) "" -}}
      {{- $encParts = append $encParts $proxy.Encryption_Mode -}}
    {{- end -}}
    {{- if ne (default "" $proxy.EncryptionRtt) "" -}}
      {{- $encParts = append $encParts $proxy.EncryptionRtt -}}
    {{- end -}}
    {{- if ne (default "" $proxy.EncryptionClientPadding) "" -}}
      {{- $encParts = append $encParts $proxy.EncryptionClientPadding -}}
    {{- end -}}
    {{- if ne (default "" $proxy.EncryptionPassword) "" -}}
      {{- $encParts = append $encParts $proxy.EncryptionPassword -}}
    {{- end -}}
    {{- $encryptionStr = join "." $encParts -}}
  {{- end }}
- name: {{ $proxy.Name | quote }}
  type: vless
  server: {{ $server }}
  port: {{ $proxy.Port }}
  uuid: {{ $password }}
  udp: true
  tfo: true
  encryption: {{ $encryptionStr }}
  {{- if ne (default "" $proxy.Flow) "" }}
  flow: {{ $proxy.Flow }}
  {{- end }}
  {{- if or (eq $proxy.Transport "ws") (eq $proxy.Transport "websocket") }}
  network: ws
  ws-opts:
    path: {{ default "/" $proxy.Path }}
    {{- if ne (default "" $proxy.Host) "" }}
    headers:
      Host: {{ $proxy.Host }}
    {{- end }}
  {{- else if eq $proxy.Transport "http" }}
  network: http
  http-opts:
    method: GET
    path: [{{ default "/" $proxy.Path | quote }}]
    {{- if ne (default "" $proxy.Host) "" }}
    headers:
      Host: [{{ $proxy.Host | quote }}]
    {{- end }}
  {{- else if eq $proxy.Transport "httpupgrade" }}
  network: httpupgrade
  httpupgrade-opts:
    path: {{ default "/" $proxy.Path }}
    {{- if ne (default "" $proxy.Host) "" }}
    headers:
      Host: {{ $proxy.Host }}
    {{- end }}
  {{- else if eq $proxy.Transport "xhttp" }}
  network: xhttp
  xhttp-opts:
    path: {{ default "/" $proxy.Path }}
    {{- if ne (default "" $proxy.Host) "" }}
    host: {{ $proxy.Host }}
    {{- end }}
    {{- if ne (default "" $proxy.XhttpMode) "" }}
    mode: {{ $proxy.XhttpMode }}
    {{- end }}
    {{- if ne (default "" $proxy.XhttpExtra) "" }}
    {{- $extra := fromJson $proxy.XhttpExtra }}
    {{- if $extra.downloadSettings }}
    {{- $ds := $extra.downloadSettings }}
    download-settings:
      server: {{ $ds.address | quote }}
      port: {{ $ds.port }}
      network: {{ default "xhttp" $ds.network }}
      tls: true
      {{- if $ds.tlsSettings }}
      servername: {{ $ds.tlsSettings.serverName | quote }}
      alpn: {{ $ds.tlsSettings.alpn | toJson }}
      client-fingerprint: {{ default "chrome" $ds.tlsSettings.fingerprint }}
      {{- end }}
      {{- if $ds.realitySettings }}
      servername: {{ default "" $ds.realitySettings.serverName | quote }}
      client-fingerprint: {{ default "chrome" $ds.realitySettings.fingerprint }}
      reality-opts:
        public-key: {{ $ds.realitySettings.publicKey | quote }}
        short-id: {{ default "" $ds.realitySettings.shortId | quote }}
      {{- end }}
      {{- if $ds.xhttpSettings }}
      xhttp-opts:
        host: {{ $ds.xhttpSettings.host | quote }}
        path: {{ $ds.xhttpSettings.path | quote }}
        mode: {{ default "auto" $ds.xhttpSettings.mode }}
      {{- end }}
    {{- end }}
    {{- end }}
  {{- else if eq $proxy.Transport "grpc" }}
  network: grpc
  grpc-opts:
    grpc-service-name: {{ default "grpc" $proxy.ServiceName }}
  {{- end }}
  {{- if or (eq $proxy.Security "tls") (eq $proxy.Security "reality") }}
  tls: true
  {{- end }}
  {{- if ne (default "" $proxy.SNI) "" }}
  servername: {{ $proxy.SNI }}
  {{- end }}
  {{- if $proxy.AllowInsecure }}
  skip-cert-verify: true
  {{- end }}
  {{- if ne (default "" $proxy.CertPinSHA256) "" }}
  fingerprint: {{ $proxy.CertPinSHA256 }}
  {{- end }}
  {{- if ne (default "" $proxy.Fingerprint) "" }}
  client-fingerprint: {{ $proxy.Fingerprint }}
  {{- end }}
  {{- if and (eq $proxy.Security "reality") (ne (default "" $proxy.RealityPublicKey) "") }}
  reality-opts:
    public-key: {{ $proxy.RealityPublicKey }}
    {{- if ne (default "" $proxy.RealityShortId) "" }}
    short-id: {{ $proxy.RealityShortId }}
    {{- end }}
  {{- end }}
  {{- if $proxy.EchEnable }}
  ech-opts:
    enable: true
    {{- if ne (default "" $proxy.EchServerName) "" }}
    query-server-name: {{ $proxy.EchServerName }}
    {{- end }}
  {{- end }}
{{- else if eq $proxy.Type "trojan" }}
- name: {{ $proxy.Name | quote }}
  type: trojan
  server: {{ $server }}
  port: {{ $proxy.Port }}
  password: {{ $password }}
  udp: true
  tfo: true
  {{- if or (eq $proxy.Security "tls") (eq $proxy.Security "reality") }}
  tls: true
  {{- end }}
  {{- if ne (default "" $proxy.SNI) "" }}
  sni: {{ $proxy.SNI }}
  {{- end }}
  {{- if $SkipVerify }}
  skip-cert-verify: true
  {{- end }}
  {{- if ne (default "" $proxy.CertPinSHA256) "" }}
  fingerprint: {{ $proxy.CertPinSHA256 }}
  {{- end }}
  {{- if ne (default "" $proxy.Fingerprint) "" }}
  client-fingerprint: {{ $proxy.Fingerprint }}
  {{- end }}
  {{- if and (eq $proxy.Security "reality") (ne (default "" $proxy.RealityPublicKey) "") }}
  reality-opts:
    public-key: {{ $proxy.RealityPublicKey }}
    {{- if ne (default "" $proxy.RealityShortId) "" }}
    short-id: {{ $proxy.RealityShortId }}
    {{- end }}
  {{- end }}
  {{- if or (eq $proxy.Transport "ws") (eq $proxy.Transport "websocket") }}
  network: ws
  ws-opts:
    path: {{ default "/" $proxy.Path }}
    {{- if ne (default "" $proxy.Host) "" }}
    headers:
      Host: {{ $proxy.Host }}
    {{- end }}
  {{- else if eq $proxy.Transport "http" }}
  network: http
  http-opts:
    method: GET
    path: [{{ default "/" $proxy.Path | quote }}]
    {{- if ne (default "" $proxy.Host) "" }}
    headers:
      Host: [{{ $proxy.Host | quote }}]
    {{- end }}
  {{- else if eq $proxy.Transport "grpc" }}
  network: grpc
  grpc-opts:
    grpc-service-name: {{ default "grpc" $proxy.ServiceName }}
  {{- end }}
  {{- if $proxy.EchEnable }}
  ech-opts:
    enable: true
    {{- if ne (default "" $proxy.EchServerName) "" }}
    query-server-name: {{ $proxy.EchServerName }}
    {{- end }}
  {{- end }}
{{- else if or (eq $proxy.Type "hysteria2") (eq $proxy.Type "hysteria") }}
- name: {{ $proxy.Name | quote }}
  type: hysteria2
  server: {{ $server }}
  port: {{ $proxy.Port }}
  password: {{ $password }}
  udp: true
  tfo: true
  {{- if ne (default "" $proxy.SNI) "" }}
  sni: {{ $proxy.SNI }}
  {{- end }}
  {{- if $proxy.AllowInsecure }}
  skip-cert-verify: true
  {{- end }}
  {{- if ne (default "" $proxy.CertPinSHA256) "" }}
  fingerprint: {{ $proxy.CertPinSHA256 }}
  {{- end }}
  {{- if ne (default "" $proxy.ObfsPassword) "" }}
  obfs: salamander
  obfs-password: {{ $proxy.ObfsPassword }}
  {{- end }}
  {{- if ne (default "" $proxy.HopPorts) "" }}
  ports: {{ $proxy.HopPorts }}
  {{- end }}
  {{- if ne (default 0 $proxy.HopInterval) 0 }}
  hop-interval: {{ $proxy.HopInterval }}
  {{- end }}
  {{- if ne (default "" (printf "%v" $proxy.UpMbps)) "" }}
  up: "{{ $proxy.UpMbps }} Mbps"
  {{- end }}
  {{- if ne (default "" (printf "%v" $proxy.DownMbps)) "" }}
  down: "{{ $proxy.DownMbps }} Mbps"
  {{- end }}
  {{- if $proxy.EchEnable }}
  ech-opts:
    enable: true
    {{- if ne (default "" $proxy.EchServerName) "" }}
    query-server-name: {{ $proxy.EchServerName }}
    {{- end }}
  {{- end }}
{{- else if eq $proxy.Type "tuic" }}
- name: {{ $proxy.Name | quote }}
  type: tuic
  server: {{ $server }}
  port: {{ $proxy.Port }}
  uuid: {{ default "" $proxy.ServerKey }}
  password: {{ $password }}
  udp: true
  tfo: true
  {{- if ne (default "" $proxy.SNI) "" }}
  sni: {{ $proxy.SNI }}
  {{- end }}
  {{- if $proxy.AllowInsecure }}
  skip-cert-verify: true
  {{- end }}
  {{- if ne (default "" $proxy.CertPinSHA256) "" }}
  fingerprint: {{ $proxy.CertPinSHA256 }}
  {{- end }}
  {{- if $proxy.DisableSNI }}
  disable-sni: true
  {{- end }}
  {{- if $proxy.ReduceRtt }}
  reduce-rtt: true
  {{- end }}
  {{- if ne (default "" $proxy.UDPRelayMode) "" }}
  udp-relay-mode: {{ $proxy.UDPRelayMode }}
  {{- end }}
  {{- if ne (default "" $proxy.CongestionController) "" }}
  congestion-controller: {{ $proxy.CongestionController }}
  {{- end }}
  {{- if $proxy.EchEnable }}
  ech-opts:
    enable: true
    {{- if ne (default "" $proxy.EchServerName) "" }}
    query-server-name: {{ $proxy.EchServerName }}
    {{- end }}
  {{- end }}
{{- else if eq $proxy.Type "wireguard" }}
- name: {{ $proxy.Name | quote }}
  type: wireguard
  server: {{ $server }}
  port: {{ $proxy.Port }}
  private-key: {{ default "" $proxy.ServerKey }}
  public-key: {{ default "" $proxy.RealityPublicKey }}
  udp: true
  tfo: true
  {{- if ne (default "" $proxy.Path) "" }}
  preshared-key: {{ $proxy.Path }}
  {{- end }}
  {{- if ne (default "" $proxy.RealityServerAddr) "" }}
  ip: {{ $proxy.RealityServerAddr }}
  {{- end }}
  {{- if ne (default 0 $proxy.RealityServerPort) 0 }}
  ipv6: {{ $proxy.RealityServerPort }}
  {{- end }}
{{- else if eq $proxy.Type "anytls" }}
- name: {{ $proxy.Name | quote }}
  type: anytls
  server: {{ $server }}
  port: {{ $proxy.Port }}
  password: {{ $password }}
  udp: true
  tfo: true
  {{- if ne (default "" $proxy.SNI) "" }}
  sni: {{ $proxy.SNI }}
  {{- end }}
  {{- if $proxy.AllowInsecure }}
  skip-cert-verify: true
  {{- end }}
  {{- if ne (default "" $proxy.CertPinSHA256) "" }}
  fingerprint: {{ $proxy.CertPinSHA256 }}
  {{- end }}
  {{- if ne (default "" $proxy.Fingerprint) "" }}
  client-fingerprint: {{ $proxy.Fingerprint }}
  {{- end }}
  {{- if $proxy.EchEnable }}
  ech-opts:
    enable: true
    {{- if ne (default "" $proxy.EchServerName) "" }}
    query-server-name: {{ $proxy.EchServerName }}
    {{- end }}
  {{- end }}
{{- else if eq $proxy.Type "snell" }}
- name: {{ $proxy.Name | quote }}
  type: snell
  server: {{ $server }}
  port: {{ $proxy.Port }}
  psk: {{ $password }}
  version: 5
  reuse: true
  udp: true
  tfo: true
  {{- $obfsMode := default "" $proxy.Obfs -}}
  {{- if and (ne $obfsMode "") (ne $obfsMode "none") }}
  obfs-opts:
    mode: {{ $obfsMode }}
    {{- if ne (default "" $proxy.ObfsHost) "" }}
    host: {{ $proxy.ObfsHost }}
    {{- end }}
  {{- end }}
{{- else }}
- name: {{ $proxy.Name | quote }}
  type: {{ $proxy.Type }}
  server: {{ $server }}
  port: {{ $proxy.Port }}
  udp: true
  tfo: true
{{- end }}
{{- end }}

- name: '🌐 本机·本地直连'
  type: direct
  udp: true
- name: '⛔️ 禁止·拒绝连接'
  type: reject
- name: '🌐 DNS_Hijack'
  type: dns

proxy-groups:
  - name: 总模式
    icon: 'https://cdn.jsdelivr.net/gh/GitMetaio/Surfing@main/app/icon/All.svg'
    type: select
    proxies:
      - ALL·延迟最低
      - ALL·负载均衡
      - ALL·故障转移
      - ALL·香港地区
      - ALL·日本地区
      - ALL·狮城地区
      - ALL·中国台湾
      - ALL·美国地区
      - ALL·其它地区
      - '🌐 本机·本地直连'
  - name: 订阅更新
    icon: 'https://cdn.jsdelivr.net/gh/GitMetaio/Surfing@main/app/icon/Update.svg'
    type: select
    proxies:
      - 总模式
      - '🌐 本机·本地直连'

  # 地区组固定紧随“订阅更新”，顺序供 SurfingTile 展示使用。
  - &region_group
    name: ALL·香港地区
    icon: 'https://cdn.jsdelivr.net/gh/GitMetaio/Surfing@main/app/icon/HK.svg'
    type: url-test
    include-all-proxies: true
    exclude-type: 'direct|reject|dns'
    filter: '(?i)(港|hk|hong ?kong)'
    url: 'https://www.gstatic.com/generate_204'
    interval: 300
    tolerance: 50
    lazy: true
    empty-fallback: '🌐 本机·本地直连'
  - <<: *region_group
    name: ALL·日本地区
    icon: 'https://cdn.jsdelivr.net/gh/GitMetaio/Surfing@main/app/icon/JP.svg'
    filter: '(?i)(日本|川日|东京|大阪|泉日|埼玉|沪日|深日|[^-]日|jp|japan)'
  - <<: *region_group
    name: ALL·狮城地区
    icon: 'https://cdn.jsdelivr.net/gh/GitMetaio/Surfing@main/app/icon/Singapore.svg'
    filter: '(?i)(新加坡|坡|狮城|sg|singapore)'
  - <<: *region_group
    name: ALL·中国台湾
    icon: 'https://cdn.jsdelivr.net/gh/GitMetaio/Surfing@main/app/icon/CN.svg'
    filter: '(?i)(台|新北|彰化|tw|taiwan|taipei)'
  - <<: *region_group
    name: ALL·美国地区
    icon: 'https://cdn.jsdelivr.net/gh/GitMetaio/Surfing@main/app/icon/US.svg'
    filter: '(?i)(美|波特兰|达拉斯|俄勒冈|凤凰城|费利蒙|硅谷|拉斯维加斯|洛杉矶|圣何塞|圣克拉拉|西雅图|芝加哥|us|united ?states)'
  - <<: *region_group
    name: ALL·其它地区
    icon: 'https://cdn.jsdelivr.net/gh/GitMetaio/Surfing@main/app/icon/Globe.svg'
    filter: '.*'
    exclude-filter: '(?i)(港|hk|hong ?kong|日本|川日|东京|大阪|泉日|埼玉|沪日|深日|[^-]日|jp|japan|美|波特兰|达拉斯|俄勒冈|凤凰城|费利蒙|硅谷|拉斯维加斯|洛杉矶|圣何塞|圣克拉拉|西雅图|芝加哥|us|united ?states|台|新北|彰化|tw|taiwan|taipei|新加坡|坡|狮城|sg|singapore|灾|网易|netease|套餐|重置|剩余|到期|订阅|群|账户|流量|有效期|时间|官网|拒绝|dns|ch|网址|售|防失)'

  - &service_group
    name: 小红书
    icon: 'https://cdn.jsdelivr.net/gh/GitMetaio/Surfing@main/app/icon/XiaoHongShu.svg'
    type: select
    proxies:
      - 总模式
      - ALL·延迟最低
      - ALL·负载均衡
      - ALL·故障转移
      - ALL·香港地区
      - ALL·日本地区
      - ALL·狮城地区
      - ALL·中国台湾
      - ALL·美国地区
      - ALL·其它地区
      - '⛔️ 禁止·拒绝连接'
      - '🌐 本机·本地直连'
  - <<: *service_group
    name: 抖音
    icon: 'https://cdn.jsdelivr.net/gh/GitMetaio/Surfing@main/app/icon/DouYin.svg'
  - <<: *service_group
    name: BiliBili
    icon: 'https://cdn.jsdelivr.net/gh/GitMetaio/Surfing@main/app/icon/BiliBili.svg'
  - <<: *service_group
    name: Steam
    icon: 'https://cdn.jsdelivr.net/gh/GitMetaio/Surfing@main/app/icon/Steam.svg'
  - <<: *service_group
    name: Apple
    icon: 'https://cdn.jsdelivr.net/gh/GitMetaio/Surfing@main/app/icon/Apple.svg'
  - <<: *service_group
    name: Microsoft
    icon: 'https://cdn.jsdelivr.net/gh/GitMetaio/Surfing@main/app/icon/Microsoft.svg'
  - <<: *service_group
    name: Telegram
    icon: 'https://cdn.jsdelivr.net/gh/GitMetaio/Surfing@main/app/icon/Telegram.svg'
  - <<: *service_group
    name: Discord
    icon: 'https://cdn.jsdelivr.net/gh/GitMetaio/Surfing@main/app/icon/Discord.svg'
  - <<: *service_group
    name: Spotify
    icon: 'https://cdn.jsdelivr.net/gh/GitMetaio/Surfing@main/app/icon/Spotify.svg'
  - <<: *service_group
    name: TikTok
    icon: 'https://cdn.jsdelivr.net/gh/GitMetaio/Surfing@main/app/icon/TikTok.svg'
  - <<: *service_group
    name: YouTube
    icon: 'https://cdn.jsdelivr.net/gh/GitMetaio/Surfing@main/app/icon/YouTube.svg'
  - <<: *service_group
    name: Netflix
    icon: 'https://cdn.jsdelivr.net/gh/GitMetaio/Surfing@main/app/icon/Netflix.svg'
  - <<: *service_group
    name: Google
    icon: 'https://cdn.jsdelivr.net/gh/GitMetaio/Surfing@main/app/icon/Google.svg'
  - <<: *service_group
    name: GoogleFCM
    icon: 'https://cdn.jsdelivr.net/gh/GitMetaio/Surfing@main/app/icon/GoogleFCM.svg'
  - <<: *service_group
    name: Facebook
    icon: 'https://cdn.jsdelivr.net/gh/GitMetaio/Surfing@main/app/icon/Facebook.svg'
  - <<: *service_group
    name: OpenAI
    icon: 'https://cdn.jsdelivr.net/gh/GitMetaio/Surfing@main/app/icon/OpenAI.svg'
  - <<: *service_group
    name: GitHub
    icon: 'https://cdn.jsdelivr.net/gh/GitMetaio/Surfing@main/app/icon/GitHub.svg'
  - <<: *service_group
    name: Twitter(X)
    icon: 'https://cdn.jsdelivr.net/gh/GitMetaio/Surfing@main/app/icon/Twitter.svg'
  - <<: *service_group
    name: DNS连接
    icon: 'https://cdn.jsdelivr.net/gh/GitMetaio/Surfing@main/app/icon/DNS.svg'
  - <<: *service_group
    name: 漏网之鱼
    icon: 'https://cdn.jsdelivr.net/gh/GitMetaio/Surfing@main/app/icon/HBASE-copy.svg'
  - name: 广告拦截
    icon: 'https://cdn.jsdelivr.net/gh/GitMetaio/Surfing@main/app/icon/No-ads-all.svg'
    type: select
    proxies:
      - PASS
      - REJECT-DROP
      - '⛔️ 禁止·拒绝连接'
      - '🌐 DNS_Hijack'
  - name: WebRTC
    icon: 'https://cdn.jsdelivr.net/gh/GitMetaio/Surfing@main/app/icon/WebRTC.svg'
    type: select
    proxies:
      - '⛔️ 禁止·拒绝连接'
      - '🌐 DNS_Hijack'
      - REJECT-DROP
      - PASS
  - name: ALL·延迟最低
    icon: 'https://cdn.jsdelivr.net/gh/GitMetaio/Surfing@main/app/icon/Return.svg'
    type: url-test
    include-all-proxies: true
    exclude-type: 'direct|reject|dns'
    exclude-filter: '(?i)(套餐|重置|剩余|到期|订阅|群|账户|流量|有效期|时间|官网|失联|余额)'
    url: 'https://www.gstatic.com/generate_204'
    interval: 300
    tolerance: 50
    lazy: true
    empty-fallback: '🌐 本机·本地直连'
  - name: ALL·负载均衡
    icon: 'https://cdn.jsdelivr.net/gh/GitMetaio/Surfing@main/app/icon/Return.svg'
    type: load-balance
    strategy: round-robin
    include-all-proxies: true
    exclude-type: 'direct|reject|dns'
    exclude-filter: '(?i)(套餐|重置|剩余|到期|订阅|群|账户|流量|有效期|时间|官网|失联|余额)'
    url: 'https://www.gstatic.com/generate_204'
    interval: 300
    lazy: true
    empty-fallback: '🌐 本机·本地直连'
  - name: ALL·故障转移
    icon: 'https://cdn.jsdelivr.net/gh/GitMetaio/Surfing@main/app/icon/Return.svg'
    type: fallback
    include-all-proxies: true
    exclude-type: 'direct|reject|dns'
    exclude-filter: '(?i)(套餐|重置|剩余|到期|订阅|群|账户|流量|有效期|时间|官网|失联|余额)'
    url: 'https://www.gstatic.com/generate_204'
    interval: 300
    lazy: true
    empty-fallback: '🌐 本机·本地直连'
  - name: 特殊地址
    icon: 'https://cdn.jsdelivr.net/gh/GitMetaio/Surfing@main/app/icon/User.svg'
    type: select
    proxies:
      - '🌐 本机·本地直连'
      - '⛔️ 禁止·拒绝连接'

rule-providers:
  WebRTC_端域:
    type: http
    behavior: classical
    format: text
    path: ./rules/WebRTC.list
    url: 'https://cdn.jsdelivr.net/gh/GitMetaio/Surfing@main/box_bll/clash/rules/WebRTC.list'
    interval: 86400
  CN_IP: &ip_provider
    type: http
    behavior: ipcidr
    format: mrs
    path: ./rules/CN_IP.mrs
    url: 'https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo-lite/geoip/cn.mrs'
    interval: 86400
  CN_域: &domain_provider
    type: http
    behavior: domain
    format: mrs
    path: ./rules/CN_域.mrs
    url: 'https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geosite/cn.mrs'
    interval: 86400
  No-ads-all_域:
    <<: *domain_provider
    path: ./rules/No-ads-all.mrs
    url: 'https://cdn.jsdelivr.net/gh/TG-Twilight/AWAvenue-Ads-Rule@main/Filters/AWAvenue-Ads-Rule-Clash.mrs'
